# Postgres (Supabase) — pooler endpoints; the direct db.*.supabase.co host is
# IPv6-only on free tier and unreachable from many Nigerian ISPs.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Slug of the installer whose calculator the homepage "Calculate your solar"
# CTA points at (the platform's flagship/default installer).
NEXT_PUBLIC_DEFAULT_CALCULATOR_SLUG="boost-power"

# Email (Resend) — optional; email sends are skipped when unset
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Inverta <noreply@inverta.app>"

# Twilio (optional — WhatsApp proposal delivery, not yet wired)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
