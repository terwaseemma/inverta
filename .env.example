# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Use the POOLER endpoints — many Nigerian ISPs block the direct db.* host.
# Transaction pooler (port 6543) for the app; session pooler (5432) for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# ─── Supabase (auth + storage) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Secret key (sb_secret_...) — used server-side for logo uploads. Never expose.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── App ─────────────────────────────────────────────────────────────────────
# Fallback origin for links when no request context exists.
# Runtime links are derived from the request, so this rarely matters.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Installer slug behind the homepage "Calculate your solar" CTA.
NEXT_PUBLIC_DEFAULT_CALCULATOR_SLUG="boostsolar"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Without a key, all email sends skip silently (features still work).
RESEND_API_KEY=""
# MUST be an address on your verified Resend domain, e.g.:
RESEND_FROM_EMAIL="Inverta <notifications@inverta.app>"
