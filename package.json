{
  "name": "inverta",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npm run db:generate && next build",
    "postinstall": "npm run db:generate",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm test --workspace @inverta/shared",
    "db:generate": "npm --workspace @inverta/db run generate",
    "db:migrate": "npm --workspace @inverta/db run migrate",
    "db:seed": "npm --workspace @inverta/db run seed",
    "db:studio": "npm --workspace @inverta/db run studio"
  },
  "dependencies": {
    "@inverta/db": "*",
    "@inverta/shared": "*",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.43.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "next": "^14.2.35",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.399.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
