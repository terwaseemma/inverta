# Postgres (Supabase or Neon) — pooled connection for the app, direct for migrations
DATABASE_URL="postgresql://postgres:password@localhost:5432/inverta?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/inverta?schema=public"

# Supabase — get from your project settings
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Inverta <noreply@inverta.app>"

# Cloudflare R2 (S3-compatible) — for proposal PDFs
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="inverta-proposals"

# Redis (Upstash or local) — for BullMQ queues and rate limiting
REDIS_URL="redis://localhost:6379"

# Twilio (optional — WhatsApp proposal delivery)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
